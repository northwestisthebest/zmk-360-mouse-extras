config ZMK_LED_INDICATOR
    bool "Binary LED indicator (layer state + pointer activity)"
    depends on DT_HAS_ZMK_LED_INDICATOR_ENABLED
    default y
    select GPIO
    select INPUT

if ZMK_LED_INDICATOR

module = ZMK_LED_INDICATOR
module-str = ZMK_LED_INDICATOR
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif # ZMK_LED_INDICATOR

config ZMK_BEHAVIOR_MOUSE_TOGGLE
    bool "Mouse button toggle behavior (&mtog)"
    depends on DT_HAS_ZMK_BEHAVIOR_MOUSE_TOGGLE_ENABLED
    default y
    select INPUT

config ZMK_MOUSE_BUTTON_WATCHDOG
    bool "Release mouse buttons left stuck after all switches are up"
    depends on ZMK_POINTING
    default y if ZMK_LED_INDICATOR
